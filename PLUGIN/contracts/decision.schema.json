{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ddadda69/GPT_DUDAS/main/PLUGIN/contracts/decision.schema.json",
  "title": "Plan Viewer Plugin Decision Submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "submissionId",
    "planId",
    "planVersion",
    "decisions"
  ],
  "properties": {
    "submissionId": {
      "type": "string",
      "format": "uuid"
    },
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "planVersion": {
      "type": "integer",
      "minimum": 1
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/decision"
      }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sectionId",
        "kind"
      ],
      "properties": {
        "sectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "kind": {
          "enum": [
            "option",
            "skip",
            "other"
          ]
        },
        "optionId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "editedText": {
          "type": "string",
          "minLength": 1
        },
        "otherText": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
