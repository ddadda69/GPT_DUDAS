{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddadda69.github.io/GPT_DUDAS/data/schema.json",
  "title": "GPT_DUDAS Plan Viewer",
  "description": "Contrato formal de Plan Viewer. Cada sección representa una decisión con una o dos opciones reales. El visor añade por interfaz No implementar, Nota y, cuando allowOther es true, Otra.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "version", "title", "sections"],
  "properties": {
    "$schema": {
      "const": "https://ddadda69.github.io/GPT_DUDAS/data/schema.json"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "description": "Identificador estable del plan. En data/plans debe coincidir exactamente con el nombre <id>.json."
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "contentMediaType": "text/markdown"
    },
    "description": {
      "type": "string",
      "contentMediaType": "text/markdown"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "contentMediaType": "text/markdown",
          "description": "Contenido completo de la propuesta tal como aparecería en una respuesta normal de ChatGPT."
        },
        "recommended": {
          "type": "boolean"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "options", "defaultOption"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "contentMediaType": "text/markdown"
        },
        "description": {
          "type": "string",
          "contentMediaType": "text/markdown"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "defaultOption": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "allowOther": {
          "type": "boolean"
        },
        "allowNote": {
          "type": "boolean"
        },
        "noteLabel": {
          "type": "string"
        },
        "notePlaceholder": {
          "type": "string"
        }
      }
    }
  }
}
